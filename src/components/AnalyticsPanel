import React, { useState, useEffect } from 'react';
import CSVExportButton from './CSVExportButton';

// 1. Preset Scenarios Configuration
const SCENARIOS = [
  {
    id: 'normal',
    label: 'Normal Startup',
    params: { temperature: 350, flowRate: 12.5, coolingTemp: 298, concentration: 1.0, conversion: 0.85 }
  },
  {
    id: 'runaway',
    label: 'Cooling Failure Runaway',
    params: { temperature: 480, flowRate: 25.0, coolingTemp: 360, concentration: 2.2, conversion: 0.42 }
  }, // Added missing comma here
  {
    id: 'optimal',
    label: 'Optimal High-Conversion Setpoint',
    params: { temperature: 365, flowRate: 8.0, coolingTemp: 285, concentration: 1.5, conversion: 0.98 }
  }
];

export default function AnalyticsPanel() {
  const [activeScenario, setActiveScenario] = useState(SCENARIOS[0].id);
  const [currentParams, setCurrentParams] = useState(SCENARIOS[0].params);
  const [history, setHistory] = useState<any[]>([]);
  const [isTableExpanded, setIsTableExpanded] = useState(true);

  // Apply scenario presets
  const handleSelectScenario = (scenario: typeof SCENARIOS[0]) => {
    setActiveScenario(scenario.id);
    setCurrentParams(scenario.params);
  };

  // Live simulation tick: appends new timestamped data to the table log
  useEffect(() => {
    const interval = setInterval(() => {
      const jitter = (val: number) => Number((val + (Math.random() - 0.5) * 0.02 * val).toFixed(2));

      const newLogEntry = {
        timestamp: new Date().toLocaleTimeString(),
        scenario: SCENARIOS.find((s) => s.id === activeScenario)?.label || 'Custom',
        temperature: jitter(currentParams.temperature),
        flowRate: jitter(currentParams.flowRate),
        coolingTemp: jitter(currentParams.coolingTemp),
        concentration: jitter(currentParams.concentration),
        conversion: Math.min(100, Math.max(0, jitter(currentParams.conversion * 100)))
      };

      setHistory((prevLogs) => [newLogEntry, ...prevLogs.slice(0, 49)]);
    }, 2000);

    return () => clearInterval(interval);
  }, [activeScenario, currentParams]);

  return (
    <div className="p-6 max-w-6xl mx-auto bg-slate-900 text-white rounded-xl shadow-2xl space-y-6 border border-slate-800 font-sans">
      
      {/* Header */}
      <div className="flex justify-between items-center border-b border-slate-800 pb-4">
        <div>
          <h2 className="text-xl font-bold text-cyan-400">Analytics, Scenario Engine & Reporting</h2>
          <p className="text-xs text-slate-400">Member 4 Operational Dashboard</p>
        </div>
        
        {/* PLACED HERE: CSV Export Button Component */}
        <CSVExportButton />
      </div>

      {/* 1. Scenario Preset Selector Toolbar */}
      <div>
        <h3 className="text-sm font-semibold text-slate-300 mb-3">Scenario Presets</h3>
        <div className="flex flex-wrap gap-3">
          {SCENARIOS.map((scenario) => (
            <button
              key={scenario.id}
              onClick={() => handleSelectScenario(scenario)}
              className={`px-4 py-2 rounded-lg text-sm font-semibold transition-all shadow-md ${
                activeScenario === scenario.id
                  ? 'bg-cyan-500 text-slate-950 ring-2 ring-cyan-300'
                  : 'bg-slate-800 text-slate-300 hover:bg-slate-700'
              }`}
            >
              {scenario.label}
            </button>
          ))}
        </div>
      </div>

      {/* Active System Setpoints Display */}
      <div className="grid grid-cols-2 md:grid-cols-5 gap-3 bg-slate-950 p-4 rounded-lg border border-slate-800 text-center">
        <div>
          <div className="text-xs text-slate-500">Reactor Temp</div>
          <div className="text-lg font-mono font-bold text-amber-400">{currentParams.temperature} K</div>
        </div>
        <div>
          <div className="text-xs text-slate-500">Flow Rate</div>
          <div className="text-lg font-mono font-bold text-cyan-400">{currentParams.flowRate} L/min</div>
        </div>
        <div>
          <div className="text-xs text-slate-500">Jacket Temp</div>
          <div className="text-lg font-mono font-bold text-blue-400">{currentParams.coolingTemp} K</div>
        </div>
        <div>
          <div className="text-xs text-slate-500">Concentration</div>
          <div className="text-lg font-mono font-bold text-purple-400">{currentParams.concentration} M</div>
        </div>
        <div>
          <div className="text-xs text-slate-500">Expected Conversion</div>
          <div className="text-lg font-mono font-bold text-emerald-400">{(currentParams.conversion * 100).toFixed(0)}%</div>
        </div>
      </div>

      {/* 2. Historical Data Table View */}
      <div className="bg-slate-950 border border-slate-800 rounded-lg overflow-hidden">
        <div 
          onClick={() => setIsTableExpanded(!isTableExpanded)}
          className="flex justify-between items-center p-4 cursor-pointer bg-slate-800/50 hover:bg-slate-800 transition"
        >
          <div className="flex items-center gap-2">
            <span className="font-semibold text-sm">Historical Data Logs</span>
            <span className="text-xs bg-cyan-950 text-cyan-400 border border-cyan-800 px-2 py-0.5 rounded-full">
              {history.length} Snapshots
            </span>
          </div>
          <span className="text-slate-400 text-sm">{isTableExpanded ? '▲ Collapse' : '▼ Expand'}</span>
        </div>

        {isTableExpanded && (
          <div className="max-h-64 overflow-y-auto">
            <table className="w-full text-left text-xs text-slate-300 border-collapse">
              <thead className="bg-slate-900 sticky top-0 text-slate-400 border-b border-slate-800 uppercase tracking-wider">
                <tr>
                  <th className="p-3">Time</th>
                  <th className="p-3">Scenario</th>
                  <th className="p-3">Temp (K)</th>
                  <th className="p-3">Flow (L/min)</th>
                  <th className="p-3">Jacket (K)</th>
                  <th className="p-3">Conc. (M)</th>
                  <th className="p-3">Conversion</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800 font-mono">
                {history.length === 0 ? (
                  <tr>
                    <td colSpan={7} className="p-4 text-center text-slate-500">Generating initial snapshots...</td>
                  </tr>
                ) : (
                  history.map((snapshot, idx) => (
                    <tr key={idx} className="hover:bg-slate-900/60 transition">
                      <td className="p-3 text-slate-400">{snapshot.timestamp}</td>
                      <td className="p-3 font-sans font-medium text-slate-200">{snapshot.scenario}</td>
                      <td className="p-3 text-amber-400">{snapshot.temperature}</td>
                      <td className="p-3 text-cyan-400">{snapshot.flowRate}</td>
                      <td className="p-3 text-blue-400">{snapshot.coolingTemp}</td>
                      <td className="p-3 text-purple-400">{snapshot.concentration}</td>
                      <td className="p-3 text-emerald-400">{snapshot.conversion}%</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        )}
      </div>

    </div>
  );
}